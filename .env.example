# e.g. FOOBARcwaav1MhNregbHJYw
GH_TOKEN=ghp_
GH_WEBHOOK_SECRET=
CF_ZONE_ID=
# Google OAuth web client; register this exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://swyx.io/tools/auth/google/callback
# Generate a random secret with at least 32 bytes; never use a password.
TOOLS_SESSION_SECRET=
# Google immutable subject ID (sub), not an email. Missing value grants no owner.
TOOLS_OWNER_GOOGLE_SUB=
# Optional public channel/reference metadata; never expose this key to the browser.
YOUTUBE_API_KEY=
# Optional shared drawing-assistant providers. Server-only; never PUBLIC_ variables.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
FEATHERLESS_API_KEY=
# Exact tool-capable model ID from your Featherless account, e.g. organization/model.
FEATHERLESS_MODEL=
RECLIP_URL=https://your-reclip-app.up.railway.app
PUBLIC_PRESENCE_ADMISSION_RATE=1
